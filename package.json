{
  "name": "@trysac/jwt-inspector",
  "version": "0.0.0",
  "description": "Inspect and verify JWTs locally with WebCrypto per RFC 7519, 7515 and 8725: explicit algorithm allowlist, key binding and a per-check report",
  "license": "MIT",
  "author": "Miguel Gomez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trysac/u067-jwt-inspector.git"
  },
  "homepage": "https://github.com/Trysac/u067-jwt-inspector#readme",
  "bugs": {
    "url": "https://github.com/Trysac/u067-jwt-inspector/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "check": "node scripts/check.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
